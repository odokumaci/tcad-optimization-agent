{
  "name": "mosfet_50nm_sobol_256",
  "output_directory": "dataset/sobol_256",
  "base_parameters": {
    "device_width_um": 1.0,
    "gate_thickness_nm": 100.0,
    "device_depth_um": 1.0,
    "bulk_doping_cm3": -1e16,
    "body_doping_cm3": -1e19,
    "source_doping_cm3": 1e20,
    "drain_doping_cm3": 1e20,
    "gate_doping_cm3": 1e20,
    "halo_depth_nm": 30.0,
    "halo_offset_nm": 10.0,
    "halo_lateral_sigma_nm": 15.0,
    "halo_vertical_sigma_nm": 10.0,
    "mobility_scale": 0.1,
    "temperature_k": 300.0
  },
  "sobol_sampling": {
    "samples": 256,
    "seed": 90,
    "parameters": {
      "gate_length_nm": {
        "min": 40.0,
        "max": 60.0,
        "scale": "linear"
      },
      "oxide_thickness_nm": {
        "min": 1.0,
        "max": 1.5,
        "scale": "linear"
      },
      "halo_peak_doping_cm3": {
        "min": 1e19,
        "max": 4e19,
        "scale": "log10"
      },
      "junction_depth_nm": {
        "min": 20.0,
        "max": 40.0,
        "scale": "linear"
      }
    }
  },
  "bias_sweep": {
    "gate_start_v": 0.0,
    "gate_stop_v": 1.2,
    "gate_step_v": 0.1,
    "drain_voltages_v": [0.05, 1.2],
    "bias_step_v": 0.1
  }
}
